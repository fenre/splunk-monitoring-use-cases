# --- Documentation placeholders (RFC 2606 / RFC 6761 reserved names) --------
# UC SPL/config examples use reserved or illustrative hostnames as stand-ins
# for customer-specific endpoints (HEC receivers, vCenter, Prism, wikis, etc.).
# None of these resolve from CI — they are intentional placeholders, not links.

# example.com / .net / .org and the bare ``.example`` TLD (e.g. splunk.example.com,
# splunk-hec.example:8088, tenable.example.com, wiki.example.corp).
^https?://([a-z0-9-]+\.)*example\.(com|net|org|corp)([/:?#]|$)
^https?://([a-z0-9-]+\.)*example([/:?#]|$)
# .invalid / .test reserved TLDs.
^https?://([a-z0-9-]+\.)*(invalid|test)([/:?#]|$)
# .local (mDNS / internal) hostnames, incl. *.example.local, *.responsible-entity.local.
^https?://[^/]*\.local([/:?#]|$)

