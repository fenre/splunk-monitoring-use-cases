{
  "$schema": "../schemas/splunk-products.schema.json",
  "schemaVersion": "1.0.0",
  "defaultProduct": "splunk-platform",
  "products": [
    {
      "id": "splunk-platform",
      "name": "Splunk Platform",
      "shortName": "Splunk Platform",
      "description": "Splunk Enterprise and Splunk Cloud Platform, including premium apps that run on them such as Splunk Enterprise Security. Use cases are implemented as SPL searches.",
      "docsUrl": "https://docs.splunk.com/Documentation/Splunk",
      "requires": ["spl", "cimModels"],
      "audits": ["spl", "cim", "splReferences"],
      "exports": {"savedSearches": true, "dashboards": true},
      "fingerprintFields": ["spl"],
      "qualityProfile": {"implementSection": "Create the search and alert"},
      "artifactTypes": []
    },
    {
      "id": "splunk-agent-observability",
      "name": "Splunk Agent Observability",
      "shortName": "Agent Observability",
      "description": "Tracing, evaluation, and runtime guardrails for LLM agents and AI applications.",
      "docsUrl": "https://agent-observability-docs.splunk.com/",
      "requires": ["productArtifacts"],
      "audits": [],
      "exports": {"savedSearches": false, "dashboards": false},
      "fingerprintFields": ["productArtifacts"],
      "qualityProfile": {"implementSection": "Configure in Splunk Agent Observability"},
      "artifactTypes": ["evaluator", "stream-alert", "agent-control", "instrumentation", "experiment", "access", "model-pricing", "tokenomics"]
    },
    {
      "id": "splunk-observability-cloud",
      "name": "Splunk Observability Cloud",
      "shortName": "Observability Cloud",
      "description": "Metrics-first observability: Infrastructure Monitoring, APM, RUM, and Synthetic Monitoring, alerted on with SignalFlow detectors.",
      "docsUrl": "https://docs.splunk.com/observability/en/",
      "requires": ["productArtifacts"],
      "audits": [],
      "exports": {"savedSearches": false, "dashboards": false},
      "fingerprintFields": ["productArtifacts"],
      "qualityProfile": {"implementSection": "Create the detector"},
      "artifactTypes": ["detector"]
    },
    {
      "id": "splunk-itsi",
      "name": "Splunk IT Service Intelligence",
      "shortName": "ITSI",
      "description": "Service-centric monitoring on the Splunk platform: services, KPIs, entities, and episodes. KPI base searches are SPL.",
      "docsUrl": "https://docs.splunk.com/Documentation/ITSI",
      "requires": ["spl"],
      "audits": ["spl", "splReferences"],
      "exports": {"savedSearches": false, "dashboards": false},
      "fingerprintFields": ["spl", "productArtifacts"],
      "qualityProfile": {"implementSection": "Configure the service and KPIs in ITSI"},
      "artifactTypes": ["service", "kpi", "aggregation-policy"]
    },
    {
      "id": "splunk-soar",
      "name": "Splunk SOAR",
      "shortName": "SOAR",
      "description": "Security orchestration, automation, and response: playbooks that act on events and containers.",
      "docsUrl": "https://docs.splunk.com/Documentation/SOARonprem",
      "requires": ["productArtifacts"],
      "audits": [],
      "exports": {"savedSearches": false, "dashboards": false},
      "fingerprintFields": ["productArtifacts"],
      "qualityProfile": {"implementSection": "Configure in Splunk SOAR"},
      "artifactTypes": ["playbook", "forwarder-group"]
    },
    {
      "id": "splunk-edge-hub",
      "name": "Splunk Edge Hub",
      "shortName": "Edge Hub",
      "description": "Edge device that collects sensor and industrial-protocol data (Modbus, OPC UA, MQTT, SNMP) and forwards it to the Splunk platform.",
      "docsUrl": "https://docs.splunk.com/Documentation/EdgeHub",
      "requires": ["productArtifacts"],
      "audits": [],
      "exports": {"savedSearches": false, "dashboards": false},
      "fingerprintFields": ["productArtifacts"],
      "qualityProfile": {"implementSection": "Configure the Edge Hub source"},
      "artifactTypes": ["source-configuration"]
    }
  ]
}
