{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/id-ledger-collisions.schema.json",
  "title": "Known pre-guarantee UC identifier collisions",
  "description": "Historical identifier reuse events that predate identityGuaranteeSince. Not enforced against the live catalogue; documented for downstream transparency.",
  "version": "1.0.0",
  "x-stability": "stable",
  "x-since": "v8.25.0",
  "schemaVersion": "1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "identityGuaranteeEffectiveVersion",
    "commit",
    "summary",
    "collisionCount",
    "collisions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "identityGuaranteeEffectiveVersion": { "type": "string" },
    "commit": { "type": "string" },
    "commitDate": { "type": "string" },
    "summary": { "type": "string" },
    "collisionCount": { "type": "integer", "minimum": 0 },
    "collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titleBefore", "titleAfter"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "titleBefore": { "type": "string" },
          "titleAfter": { "type": "string" }
        }
      }
    }
  }
}
