{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/id-ledger.schema.json",
  "title": "UC identifier ledger",
  "description": "Append-only record of every UC identifier (X.Y.Z) ever issued. Active rows track the current content fingerprint and an append-only revision history; removed rows are never reissued.",
  "version": "1.1.0",
  "x-stability": "stable",
  "x-since": "v8.25.0",
  "x-changelog": "/schemas/changelogs/id-ledger.md",
  "schemaVersion": "1.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "catalogueCommit",
    "catalogueVersion",
    "identityGuaranteeSince",
    "identityBaselineVersion",
    "identityBaselineCommit",
    "hashAlgorithm",
    "fingerprintFields",
    "entryCount",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "catalogueCommit": {
      "type": "string"
    },
    "catalogueVersion": {
      "type": "string"
    },
    "identityGuaranteeSince": {
      "type": "string",
      "description": "First catalogue release that ships permanent-identity enforcement."
    },
    "identityBaselineVersion": {
      "type": "string",
      "description": "Last release before enforcement. Revision 1 of every identifier present in it is hashed from that release's tagged content."
    },
    "identityBaselineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Commit of the identity baseline release tag."
    },
    "hashAlgorithm": {
      "const": "sha256"
    },
    "fingerprintFields": {
      "type": "array",
      "description": "Default fingerprint surface (Splunk-platform use cases). A revision hashed from a different surface records its own fingerprintFields.",
      "items": {
        "type": "string",
        "enum": ["title", "spl"]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "seedPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "entryCount": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "fingerprintRevision": {
      "type": "object",
      "required": ["contentFingerprint", "catalogueVersion"],
      "additionalProperties": false,
      "properties": {
        "contentFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalogueVersion": {
          "type": "string",
          "minLength": 1
        },
        "catalogueCommit": {
          "type": "string",
          "minLength": 1
        },
        "fingerprintFields": {
          "type": "array",
          "description": "Fields this revision was hashed from, when not the header default (set by the UC's primary product in data/splunk-products.json; see ADR-0017).",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "contentFingerprint",
        "fingerprintRevisions",
        "firstSeenVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "removed"]
        },
        "contentFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Denormalized latest fingerprint (mirrors the last fingerprintRevisions row)."
        },
        "fingerprintRevisions": {
          "type": "array",
          "minItems": 1,
          "description": "Append-only history of content fingerprints; regeneration must never shorten this list.",
          "items": {
            "$ref": "#/$defs/fingerprintRevision"
          }
        },
        "firstSeenVersion": {
          "type": "string",
          "minLength": 1
        },
        "firstSeenVersionSource": {
          "type": "string"
        },
        "firstSeenVersionNote": {
          "type": "string"
        },
        "removedInVersion": {
          "type": "string",
          "description": "Release that removed the identifier. Omitted when removal predates the identity baseline and the release was not reconstructed."
        },
        "removedInVersionNote": {
          "type": "string"
        },
        "contentFingerprintNote": {
          "type": "string"
        }
      }
    }
  }
}
