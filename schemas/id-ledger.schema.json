{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/id-ledger.schema.json",
  "title": "UC identifier ledger",
  "description": "Append-only record of every UC identifier (X.Y.Z) ever issued. Active rows track the current content fingerprint; removed rows are never reissued.",
  "version": "1.0.0",
  "x-stability": "stable",
  "x-since": "v8.25.0",
  "schemaVersion": "1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "catalogueCommit",
    "catalogueVersion",
    "identityGuaranteeSince",
    "hashAlgorithm",
    "fingerprintFields",
    "entryCount",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "catalogueCommit": {
      "type": "string"
    },
    "catalogueVersion": {
      "type": "string"
    },
    "identityGuaranteeSince": {
      "type": "string",
      "description": "Catalogue version from which permanent-identity enforcement applies."
    },
    "hashAlgorithm": {
      "const": "sha256"
    },
    "fingerprintFields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["title", "spl"]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "seedPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "entryCount": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "status", "contentFingerprint", "firstSeenVersion"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "removed"]
        },
        "contentFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "firstSeenVersion": {
          "type": "string",
          "minLength": 1
        },
        "firstSeenVersionSource": {
          "type": "string"
        },
        "firstSeenVersionNote": {
          "type": "string"
        },
        "removedInVersion": {
          "type": "string"
        },
        "contentFingerprintNote": {
          "type": "string"
        }
      }
    }
  }
}
