{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/product-fit-rules.schema.json",
  "title": "Product-fit audit rules",
  "description": "Per-product facts that audit-uc-product-fit uses to find use cases whose SPL fakes another Splunk product: how that product's data is recognised in SPL, and which indexes, sourcetypes, and search commands its documentation names as the ingest path into the Splunk platform. Every product needs at least one evidence citation. See docs/adr/0017-splunk-product-per-use-case.md.",
  "version": "1.0.0",
  "x-stability": "preview",
  "x-since": "v8.27",
  "x-changelog": "/schemas/changelogs/product-fit-rules.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "products"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "products": {
      "type": "object",
      "description": "Keyed by product id from data/splunk-products.json.",
      "additionalProperties": {"$ref": "#/$defs/productRule"}
    }
  },
  "$defs": {
    "productRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliases", "dataMarkers", "documentedIngest", "evidence"],
      "properties": {
        "aliases": {
          "type": "array",
          "description": "Other names the product is referred to by in prose (former names, component names), in addition to the registry name and shortName.",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "dataMarkers": {
          "type": "array",
          "description": "Case-insensitive regular expressions. An index or sourcetype in a UC's SPL that matches one is treated as this product's data.",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "documentedIngest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indexes", "sourcetypes", "commands"],
          "properties": {
            "indexes": {"$ref": "#/$defs/names"},
            "sourcetypes": {"$ref": "#/$defs/names"},
            "commands": {"$ref": "#/$defs/names"}
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "names": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {
          "type": "string",
          "description": "Vendor documentation URL, or skill:<skill-name>#<section> for a product skill.",
          "pattern": "^(https://|skill:[a-z0-9-]+(#[a-z0-9-]+)?$)"
        }
      }
    }
  }
}
