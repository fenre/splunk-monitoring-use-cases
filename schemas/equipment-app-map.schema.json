{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/equipment-app-map.schema.json",
  "title": "Equipment-to-Splunkbase app map",
  "description": "Curated mapping from equipment registry slugs to Splunkbase technical add-ons and optional DSA ingest source ids. Consumed by the equipment picker (Phase 2) and gated by audit-equipment-app-map.",
  "version": "1.0.0",
  "x-stability": "preview",
  "x-since": "v8.25",
  "x-changelog": "/schemas/changelogs/equipment-app-map.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "entries"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Repo-relative path to this schema file (for editor validation)."
    },
    "version": {
      "type": "string",
      "description": "Semver of this map document.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-.+)?$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when this file was last curated."
    },
    "entries": {
      "type": "object",
      "description": "Equipment slug → Splunkbase apps and/or DSA ingest sources.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/equipmentEntry"
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_]*$"
      }
    }
  },
  "$defs": {
    "equipmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apps": {
          "type": "array",
          "description": "Splunkbase technical add-ons that collect or parse data for this equipment slug.",
          "items": {
            "$ref": "#/$defs/appRef"
          },
          "uniqueItems": true
        },
        "dsaSourceIds": {
          "type": "array",
          "description": "Optional DSA catalogue source ids (from tools/data-sizing/ot-data-sources.js) for ingest-only or complementary sizing guidance.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "required": ["apps"],
          "properties": {
            "apps": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["dsaSourceIds"],
          "properties": {
            "dsaSourceIds": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "appRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "role", "premium"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Numeric Splunkbase app id as a string.",
          "pattern": "^[0-9]{2,6}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "description": "Must match data/splunkbase-catalog.json displayName exactly."
        },
        "role": {
          "type": "string",
          "enum": ["primary", "data-source", "optional", "premium"],
          "description": "How the picker should present this app relative to the equipment slug."
        },
        "premium": {
          "type": "boolean",
          "description": "True when the app is a paid Splunkbase listing or requires a premium Splunk license."
        }
      }
    }
  }
}
