{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/sourcetypes.schema.json",
  "title": "Fabric sourcetype registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "entityType", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entityType": { "const": "sourcetype" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonical", "aliases", "usageCount", "vendorProduct", "addon", "cimDatasets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "canonical": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "usageCount": { "type": "integer", "minimum": 1 },
          "vendorProduct": { "type": ["string", "null"] },
          "addon": { "type": ["string", "null"] },
          "cimDatasets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
