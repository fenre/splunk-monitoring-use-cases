{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/business-outcomes.schema.json",
  "title": "Fabric business-outcome registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "entityType", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entityType": { "const": "businessOutcome" },
    "entries": {
      "type": "array",
      "minItems": 10,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/concept" }
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "phrases", "usageCount"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "phrases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "usageCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
