{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/addons.schema.json",
  "title": "Fabric add-on registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "entityType", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entityType": { "const": "addon" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "splunkbaseId", "name", "folderName", "aliases", "inSplunkbaseCatalog", "usageCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]+$" },
          "splunkbaseId": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "folderName": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "inSplunkbaseCatalog": { "type": "boolean" },
          "usageCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
