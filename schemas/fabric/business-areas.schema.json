{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/business-areas.schema.json",
  "title": "Fabric business-area registry",
  "version": "1.0.0",
  "x-stability": "preview",
  "x-since": "v8.25",
  "x-changelog": "/schemas/changelogs/fabric.md",
  "description": "Business areas are seller concepts. They are not technology categories and they are not industries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "entityType", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entityType": { "const": "businessArea" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "phrases", "usageCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string" },
          "phrases": { "type": "array", "items": { "type": "string" } },
          "usageCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
