{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/ambiguous.schema.json",
  "title": "Fabric ambiguous-value list",
  "version": "1.0.0",
  "x-stability": "preview",
  "x-since": "v8.25",
  "x-changelog": "/schemas/changelogs/fabric.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "description", "values"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "reason", "usageCount"],
        "properties": {
          "kind": { "type": "string" },
          "value": { "type": "string" },
          "reason": { "type": "string" },
          "usageCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
