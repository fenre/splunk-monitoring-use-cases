{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/cim.schema.json",
  "title": "Fabric CIM dataset and field registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "entityType", "datasets", "fields"],
  "properties": {
    "$schema": { "type": "string" },
    "entityType": { "const": "cim" },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "dataset", "usageCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "model": { "type": "string" },
          "dataset": { "type": "string" },
          "usageCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "dataset", "usageCount"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "dataset": { "type": "string" },
          "usageCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
