{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/industries.schema.json",
  "title": "Fabric industry registry",
  "version": "1.0.0",
  "x-stability": "preview",
  "x-since": "v8.25",
  "x-changelog": "/schemas/changelogs/fabric.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "entityType", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entityType": { "const": "industry" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "aliases", "usageCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "usageCount": { "type": "integer", "minimum": 2 }
        }
      }
    }
  }
}
