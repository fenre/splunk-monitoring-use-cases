{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/fabric/vendor-products.schema.json",
  "title": "Fabric vendor-product registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "entityType", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entityType": { "const": "vendorProduct" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vendor", "product", "kind", "aliases", "models", "usageCount"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "vendor": { "type": "string" },
          "product": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "usageCount"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "usageCount": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "usageCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
