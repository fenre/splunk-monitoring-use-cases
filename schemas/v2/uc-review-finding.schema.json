{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/v2/uc-review-finding.schema.json",
  "title": "UC text-quality review record",
  "description": "One review record per use case per review tier. Produced by audit-text-quality (tier=deterministic) and by scripts/uc_review_runner.py (tier=triage|deep|adjudication). Grading rubric: docs/uc-text-review-rubric.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "uc_id",
    "content_sha256",
    "tier",
    "model",
    "rubric_version",
    "findings",
    "firewalled_field_flags"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "uc_id": { "type": "string", "pattern": "^UC-\\d+\\.\\d+\\.\\d+$" },
    "file": { "type": "string", "pattern": "^content/cat-[^/]+/UC-[^/]+\\.json$" },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tier": { "enum": ["deterministic", "triage", "deep", "adjudication"] },
    "model": { "type": "string", "minLength": 1 },
    "rubric_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string" },
    "verdict": {
      "description": "ok: publishable as is. polish: minor issues only. rewrite: templated or not actionable. incorrect: at least one factual error.",
      "enum": ["ok", "polish", "rewrite", "incorrect"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clarity": { "$ref": "#/$defs/score" },
        "specificity": { "$ref": "#/$defs/score" },
        "consistency": { "$ref": "#/$defs/score" },
        "correctness": { "$ref": "#/$defs/score" },
        "grandma_fidelity": { "$ref": "#/$defs/score" },
        "overclaiming": { "$ref": "#/$defs/score" }
      }
    },
    "summary": { "type": "string", "maxLength": 800 },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "firewalled_field_flags": {
      "description": "Problems in fields the AI fix loop must not edit (spl, cimSpl, compliance, classification, identity). Human-owned follow-up only.",
      "type": "array",
      "items": { "$ref": "#/$defs/firewalledFlag" }
    },
    "adjudicates": {
      "description": "tier=adjudication only: the tier and model whose blocker findings this record re-examined.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "model"],
      "properties": {
        "tier": { "enum": ["triage", "deep"] },
        "model": { "type": "string", "minLength": 1 },
        "agrees": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "tier": { "enum": ["triage", "deep", "adjudication"] } } },
      "then": {
        "required": ["verdict", "confidence", "scores"],
        "properties": {
          "scores": {
            "required": [
              "clarity",
              "specificity",
              "consistency",
              "correctness",
              "grandma_fidelity",
              "overclaiming"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "score": {
      "description": "1 = unusable, 3 = acceptable with edits, 5 = exemplary.",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "dimension": {
      "enum": [
        "clarity",
        "specificity",
        "consistency",
        "correctness",
        "grandma_fidelity",
        "overclaiming",
        "spelling"
      ]
    },
    "severity": {
      "description": "blocker: factually wrong or misleading. major: templated or not actionable. minor: style. needs_verification: a suspected correctness problem without evidence.",
      "enum": ["blocker", "major", "minor", "needs_verification"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "dimension", "severity", "explanation"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "dimension": { "$ref": "#/$defs/dimension" },
        "severity": { "$ref": "#/$defs/severity" },
        "check": { "type": "string" },
        "quote": { "type": "string", "maxLength": 500 },
        "explanation": { "type": "string", "minLength": 10 },
        "suggested_fix": { "type": "string" },
        "evidence_url": { "type": "string", "pattern": "^https?://" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension": { "const": "correctness" },
              "severity": { "const": "blocker" }
            },
            "required": ["dimension", "severity"]
          },
          "then": {
            "anyOf": [{ "required": ["evidence_url"] }, { "required": ["evidence_ref"] }]
          }
        }
      ]
    },
    "firewalledFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "issue", "severity"],
      "properties": {
        "field": {
          "enum": [
            "spl",
            "cimSpl",
            "compliance",
            "monitoringType",
            "splunkPillar",
            "criticality",
            "difficulty",
            "title",
            "id",
            "mitreAttack"
          ]
        },
        "issue": { "type": "string", "minLength": 10 },
        "severity": { "$ref": "#/$defs/severity" },
        "evidence_url": { "type": "string", "pattern": "^https?://" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
