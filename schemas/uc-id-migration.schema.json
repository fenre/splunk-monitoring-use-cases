{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/uc-id-migration.schema.json",
  "title": "UC identifier bulk-migration manifest",
  "description": "Required when a PR changes more than the blast-radius threshold of UC identifiers. Lists every identifier add, remove, or remap and whether content identity is preserved.",
  "version": "1.0.0",
  "x-stability": "stable",
  "x-since": "v8.25.0",
  "schemaVersion": "1.0.0",
  "type": "object",
  "required": ["schemaVersion", "description", "changes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "description": {
      "type": "string",
      "minLength": 8
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "required": ["kind", "identityPreserved"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["add", "remove", "remap"]
        },
        "from": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "to": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "identityPreserved": {
          "type": "boolean",
          "description": "True when the use case (title+SPL fingerprint) is unchanged across the migration."
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
