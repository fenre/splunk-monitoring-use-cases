{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/splunk-monitoring-use-cases/schemas/recommendation-profile.schema.json",
  "title": "Recommendation profile",
  "description": "Cited, ordered starting set of catalogue use cases for one product. Not a compliance evidence pack. Value is editorial; readiness is computed at consume time.",
  "version": "1.0.0",
  "x-stability": "preview",
  "x-since": "v8.7.3",
  "x-changelog": "/schemas/changelogs/recommendation-profile.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "label",
    "variants",
    "corePack",
    "role",
    "outcomes",
    "valueHypothesis",
    "requiredData",
    "deps",
    "suites",
    "maturity",
    "sourceIds",
    "reviewDate",
    "confidence",
    "rationale"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "description": "Equipment slug this profile ranks (cisco_ise, linux, …)."
    },
    "label": { "type": "string", "minLength": 3, "maxLength": 80 },
    "variants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Deployment variants (on-prem PAN, distributed ISE, EKS, …)."
    },
    "corePack": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ucId", "rank", "why", "whyNow", "metric", "dataNeeded", "sourceIds"],
        "properties": {
          "ucId": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Sidecar id without UC- prefix."
          },
          "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
          "role": { "type": "string" },
          "why": { "type": "string", "minLength": 20, "maxLength": 400 },
          "whyNow": { "type": "string", "minLength": 12, "maxLength": 400 },
          "blocker": { "type": "string", "maxLength": 400 },
          "metric": { "type": "string", "minLength": 8, "maxLength": 200 },
          "dataNeeded": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "classHint": {
            "type": "string",
            "enum": ["start_now", "high_value_blocked", "foundation", "later"]
          }
        }
      }
    },
    "role": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Primary operator roles this pack serves."
    },
    "outcomes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Operational outcomes (availability, identity, threat, …)."
    },
    "valueHypothesis": {
      "type": "string",
      "minLength": 40,
      "maxLength": 800,
      "description": "Qualitative why-this-pack. No invented ROI figures."
    },
    "requiredData": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Prerequisite UC ids or capability notes."
    },
    "suites": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Splunk suites that change readiness (ES, ITSI, O11y)."
    },
    "maturity": {
      "type": "string",
      "enum": ["crawl", "walk", "run"]
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Keys in data/source-references.json."
    },
    "reviewDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "confidence": {
      "type": "string",
      "enum": ["gold", "silver", "bronze"]
    },
    "rationale": { "type": "string", "minLength": 40, "maxLength": 1200 }
  }
}
